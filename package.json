{
  "name": "spa-react-starter",
  "version": "0.0.0",
  "private": true,
  "description": "Production-ready React single-page app with TanStack Router and Query, a typed OpenAPI client, cookie sessions, and a hardened nginx image",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build && node scripts/compress.ts",
    "preview": "vite preview",
    "gen:api": "scripts/gen-api.sh",
    "check:api": "scripts/check-api.sh",
    "check:bundle": "pnpm build && size-limit && scripts/check-bundle.sh",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "COVERAGE=true vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:api && pnpm test && pnpm test:coverage && pnpm check:bundle && .agents/check.sh && .github/scripts/check-repo-standards.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^8.1.0",
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "lighthouse": "^13.6.0",
    "msw": "^3.0.5",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.65.0",
    "size-limit": "^14.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "sideEffects": [
    "*.css",
    "./src/main.tsx"
  ]
}
