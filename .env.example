# The API that /api/ proxies to: scheme, host, and optional port, with no path.
# pnpm dev reads it here. The Docker image reads it from its environment and refuses to start without it.
API_UPSTREAM=http://localhost:3000

# The OpenAPI document pnpm gen:api copies into openapi.yaml before generating types: a file path or URL.
API_SCHEMA=openapi.yaml
